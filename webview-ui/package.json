{
  "name": "audio-toolkit-webview",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:standalone": "vite --config vite.standalone.config.ts --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --config vite.standalone.config.ts",
    "test:local": "node --test tests/*.test.mjs",
    "lint": "eslint src --ext ts,tsx",
    "watch": "vite build --mode development --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@shren/fftw-js": "^0.1.10",
    "@shren/typed-event-emitter": "^1.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/verovio": "^3.13.4",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vscode/codicons": "^0.0.36",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "sass": "^1.77.8",
    "typescript": "^5.5.3",
    "verovio": "^4.2.0",
    "vite": "^5.3.3",
    "window-function": "^2.1.0"
  }
}
